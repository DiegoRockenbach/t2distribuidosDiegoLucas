# Copie para .env e ajuste as senhas. O .env nao e versionado.

# Banco da aplicacao (usuario e banco criados no primeiro boot do cluster)
POSTGRES_DB=air_quality
POSTGRES_USER=air_user
POSTGRES_PASSWORD=change_this_local_password

# Usuarios internos do PostgreSQL gerenciados pelo Patroni
PG_SUPERUSER_PASSWORD=change_this_superuser_password
PG_REPLICATION_PASSWORD=change_this_replication_password
PG_REWIND_PASSWORD=change_this_rewind_password

# Portas publicadas no hospedeiro
API_PORT=3000
FRONTEND_PORT=8080
HAPROXY_STATS_PORT=8404
DB_PRIMARY_PORT=5000
DB_REPLICAS_PORT=5001
PATRONI_PG1_PORT=8008
PATRONI_PG2_PORT=8009
PATRONI_PG3_PORT=8010

# API (valores por replica)
# primary: leituras no primario (consistencia forte), replicas como alternativa
# replicas: leituras nas replicas (escala leituras; podem estar levemente atrasadas)
READ_ROUTING=primary
DB_POOL_MIN=1
DB_POOL_MAX=5
BASELINE_DB_POOL_MAX=15
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=10000
DB_RETRY_BUDGET_MS=2500
SHUTDOWN_GRACE_MS=3000
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=warn

# Execucao local da API fora do Docker (npm run dev): aponta para o HAProxy
DATABASE_URL=postgresql://air_user:change_this_local_password@localhost:5000/air_quality
DATABASE_READ_URL=postgresql://air_user:change_this_local_password@localhost:5001/air_quality
