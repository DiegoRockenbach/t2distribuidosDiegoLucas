{
  "name": "air-quality-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:index": "tsx scripts/index-control.ts",
    "db:explain": "tsx scripts/explain.ts",
    "db:export-load": "tsx scripts/export-load-records.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:seed:prod": "node dist/scripts/seed.js",
    "db:index:prod": "node dist/scripts/index-control.js",
    "db:explain:prod": "node dist/scripts/explain.js",
    "db:export-load:prod": "node dist/scripts/export-load-records.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
